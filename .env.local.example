# Local Postgres — e.g. postgresql://user:password@localhost:5432/personal_assistant
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_assistant"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for Calendar sync) — create at console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  tasks    Task[]
  events   Event[]
  calendarSyncLogs CalendarSyncLog[]
  accounts Account[]
  sessions Session[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#6366f1")
  status      ProjectStatus @default(IN_PROGRESS)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETE
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]   @relation("Subtasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean  @default(false)
  source        EventSource @default(LOCAL)
  externalImportUid String? @unique
  googleEventId String?  @unique
  localEdits    Boolean  @default(false)
  lastLocalEditAt DateTime?
  lastGoogleSyncAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EventSource {
  LOCAL
  GOOGLE
  IMPORTED
}

model CalendarSyncLog {
  id         String   @id @default(cuid())
  trigger    String   @default("manual")
  status     String   @default("success")
  synced     Int      @default(0)
  skipped    Int      @default(0)
  conflicts  Int      @default(0)
  total      Int      @default(0)
  detail     String?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at                Int?
  token_type                String?
  scope                     String?
  id_token                  String? @db.Text
  session_state             String?
  refresh_token_expires_in  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
